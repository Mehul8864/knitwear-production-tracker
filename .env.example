# ============================================================
# StitchOps Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — SERVER-SIDE ONLY. NEVER expose to client.
# Used only in the seed script and server-side admin operations.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── OpenAI (optional — enables AI features) ─────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Classification model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Transcription model (default: whisper-1)
WHISPER_MODEL=whisper-1

# ─── Application ─────────────────────────────────────────────
# Base URL for generating buyer access links
NEXT_PUBLIC_APP_URL=http://localhost:3000
