# ============================================================
# StitchOps Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.
# ============================================================

# ─── Supabase — Browser-safe (exposed to client) ───────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Modern key name (preferred):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy fallback (still works):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase — Server-only (NEVER expose to browser) ──────
# Server-side URL (optional — falls back to NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://your-project.supabase.co

# Secret key for admin operations (seed script, server-side only)
# Modern key name (preferred):
SUPABASE_SECRET_KEY=your-secret-key-here
# Legacy fallback (still works):
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── OpenAI (optional — enables AI features) ─────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Classification model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Transcription model (default: whisper-1)
WHISPER_MODEL=whisper-1

# ─── Application ─────────────────────────────────────────────
# Base URL for generating buyer access links
NEXT_PUBLIC_APP_URL=http://localhost:3000
